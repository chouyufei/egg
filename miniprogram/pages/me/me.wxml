<page-meta page-style="{{ pageStyle }}"></page-meta>

<view wx:if="{{ user }}">
  <view class="hero">
    <view class="row" style="gap: 24rpx;">
      <view class="avatar">🥚</view>
      <view class="flex-1">
        <view class="hero-title" bindtap="editName">
          {{ user.name }} <text class="hero-edit">✎</text>
        </view>
        <view class="hero-sub">{{ user.phone }}</view>
        <view class="hero-sub" bindtap="goSetLoc" style="margin-top: 6rpx;">📍 {{ locName || '未设置位置，点此设置' }} ›</view>
        <view class="mt-8">
          <text class="tag {{ licCls }}">资质 {{ licText }}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card menu-card" style="margin: 32rpx 24rpx;">
    <view class="menu-row" bindtap="goQualify">
      <text>📜 资质认证</text><text class="muted">{{ licText }} ›</text>
    </view>
    <view wx:if="{{ !reviewMode }}" class="menu-row" bindtap="goWallet">
      <text>💴 我的钱包</text>
      <text class="muted">余额 ¥{{ walletBalance }} ›</text>
    </view>
    <view class="menu-row" bindtap="goMessages">
      <text>📩 消息中心</text><text class="muted">{{ unread ? unread + ' 条未读 ›' : '›' }}</text>
    </view>
    <view class="menu-row" bindtap="goAuction">
      <text>🔥 我的参与</text>
      <text class="muted">›</text>
    </view>
  </view>

  <view class="card menu-card" style="margin: 24rpx 24rpx;">
    <view class="menu-row" bindtap="goSettings">
      <text>⚙️ 界面设置</text><text class="muted">字体 / 主题 ›</text>
    </view>
    <view class="menu-row" bindtap="goAgreement">
      <text>📜 用户协议</text><text class="muted">›</text>
    </view>
    <view class="menu-row" bindtap="goPrivacy">
      <text>🛡 隐私政策</text><text class="muted">›</text>
    </view>
    <view class="menu-row" bindtap="goAbout">
      <text>ℹ️ 关于我们</text><text class="muted">v1.0.0 ›</text>
    </view>
  </view>

  <view class="card menu-card" style="margin: 24rpx 24rpx;">
    <view class="menu-row" bindtap="logout">
      <text>🚪 退出登录</text><text class="muted">›</text>
    </view>
  </view>
</view>

<!-- 游客视图：未登录 -->
<view wx:if="{{ isGuest }}">
  <view class="hero">
    <view class="row" style="gap: 24rpx;">
      <view class="avatar">🥚</view>
      <view class="flex-1">
        <view class="hero-title">未登录</view>
        <view class="hero-sub">登录后可发布货源、报价、下单、查看钱包</view>
      </view>
    </view>
    <button class="btn mt-16" bindtap="goLogin">登录 / 注册</button>
  </view>

  <view class="card menu-card" style="margin: 32rpx 24rpx;">
    <view class="menu-row" bindtap="goSettings">
      <text>⚙️ 界面设置</text><text class="muted">字体 / 主题 ›</text>
    </view>
    <view class="menu-row" bindtap="goAgreement">
      <text>📜 用户协议</text><text class="muted">›</text>
    </view>
    <view class="menu-row" bindtap="goPrivacy">
      <text>🛡 隐私政策</text><text class="muted">›</text>
    </view>
    <view class="menu-row" bindtap="goAbout">
      <text>ℹ️ 关于我们</text><text class="muted">v1.0.0 ›</text>
    </view>
  </view>
</view>
