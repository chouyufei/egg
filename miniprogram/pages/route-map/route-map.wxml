<view class="wrap">
  <map class="map"
       latitude="{{ centerLat }}"
       longitude="{{ centerLng }}"
       markers="{{ markers }}"
       polyline="{{ polyline }}"
       include-points="{{ includePoints }}"
       show-location
       enable-traffic
       scale="10"></map>

  <view class="info-card">
    <view class="info-row">
      <view class="info-icon" style="background: #1c5bd8;">📍</view>
      <view class="flex-1">
        <view class="info-title">我的位置</view>
        <view class="info-sub muted">{{ me.lat }}, {{ me.lng }}</view>
      </view>
    </view>
    <view class="dist-line">
      <view class="dist-dot"></view>
      <view class="dist-bar"></view>
      <view class="dist-text">直线距离 <text class="bold" style="color: #e0a40d;">{{ distText }}</text></view>
      <view class="dist-bar"></view>
      <view class="dist-dot"></view>
    </view>
    <view class="info-row">
      <view class="info-icon" style="background: #ee0a24;">🐔</view>
      <view class="flex-1">
        <view class="info-title">{{ dst.label }}</view>
        <view class="info-sub muted">{{ dst.lat }}, {{ dst.lng }}</view>
      </view>
    </view>

    <view class="row" style="gap: 16rpx; margin-top: 24rpx;">
      <button class="btn flex-1" bindtap="openNativeToDst">🧭 导航到{{ dst.label }}</button>
    </view>
    <view class="muted text-c mt-8" style="font-size: 22rpx;">
      点击「导航」打开微信地图，可继续调起高德 / 百度等第三方导航
    </view>
  </view>
</view>
