<view wx:if="{{ !user }}" class="empty">未登录，请重新打开应用</view>

<!-- 管理员提示 -->
<block wx:if="{{ user.role === 'admin' }}">
  <view class="page-pad">
    <view class="card text-c" style="padding: 80rpx 32rpx;">
      <view style="font-size: 80rpx;">⚙️</view>
      <view class="bold mt-8">管理员请使用 Web 后台</view>
      <view class="muted mt-8">在电脑上访问 http://localhost:5173/#/admin</view>
      <button class="btn-plain mt-16" bindtap="logout">退出登录</button>
    </view>
  </view>
</block>

<block wx:if="{{ user.role === 'farm' || user.role === 'buyer' }}">
  <!-- 顶部：3 段 卖/买/其他 -->
  <view class="hero">
    <view class="row-between" style="margin-bottom: 16rpx;">
      <view class="hero-title">🥚 凤伯乐</view>
      <view class="bell" bindtap="goMessages">🔔<text wx:if="{{ unread }}" class="bell-badge">{{ unread }}</text></view>
    </view>

    <view class="mode-bar">
      <view class="mode-seg {{ user.role === 'farm' ? 'on' : '' }}" bindtap="switchToMode" data-r="farm">🐔 卖</view>
      <view class="mode-seg {{ user.role === 'buyer' ? 'on' : '' }}" bindtap="switchToMode" data-r="buyer">🛒 买</view>
      <view class="mode-seg" bindtap="goMore">⋯ 其他</view>
    </view>

    <view class="search-wrap" bindtap="goSearch">🔍 搜地区 / 鸡种 / 蛋色</view>
  </view>

  <!-- 资质/保证金引导 -->
  <view wx:if="{{ guideText }}" class="card guide-card">
    <view class="row-between">
      <view class="flex-1">
        <view class="bold">{{ guideTitle }}</view>
        <view class="muted mt-8">{{ guideText }}</view>
      </view>
      <button class="btn-plain" style="padding: 6rpx 24rpx;" bindtap="guideAction">{{ guideAction }}</button>
    </view>
  </view>

  <!-- 蛋品类目：入口卡（点了进二级页选） -->
  <view class="cat-entry" bindtap="goCategory">
    <view class="cat-entry-icon">🥚</view>
    <view class="flex-1">
      <view class="cat-entry-title">蛋品类目</view>
      <view class="cat-entry-sub muted">{{ activeColor ? '当前：' + activeColor : '红壳 · 粉壳 · 土鸡蛋 · 全部' }}</view>
    </view>
    <view class="cat-entry-arrow">›</view>
  </view>

  <!-- 区域分类（绿色块） -->
  <view class="region-block">
    <view class="region-head">
      <text class="region-dot">📍</text>
      <text>区域分类</text>
      <text wx:if="{{ activeProvince }}" class="region-active">当前：{{ activeProvince }}</text>
    </view>
    <scroll-view scroll-x class="prov-scroll">
      <view class="prov-chip {{ activeProvince === '' ? 'on' : '' }}" bindtap="pickProvince" data-v="">推荐</view>
      <view class="prov-chip {{ activeProvince === item ? 'on' : '' }}" wx:for="{{ provinces }}" wx:key="*this"
            bindtap="pickProvince" data-v="{{ item }}">{{ item }}</view>
    </scroll-view>
  </view>

  <!-- 卖方：只显示「我的货源」 -->
  <block wx:if="{{ user.role === 'farm' }}">
    <view class="row-between" style="padding: 16rpx 24rpx 0;">
      <view class="bold" style="font-size: 30rpx;">我的货源 ({{ mine.length }})</view>
    </view>
    <view class="page-pad">
      <view class="grid">
        <view class="grid-cell" wx:for="{{ mine }}" wx:key="id">
          <egg-card r="{{ item }}" bind:cardtap="openRes" data-id="{{ item.id }}" />
        </view>
      </view>
      <empty wx:if="{{ !mine.length }}" icon="🐔" text="还没发布过货源，点底部发布按钮立即发布" />
    </view>
  </block>

  <!-- 买方：货源 + 我的求购 切换 -->
  <block wx:else>
    <view class="kind-tabs">
      <view class="kind-tab {{ viewTab === 'others' ? 'on' : '' }}" bindtap="setViewTab" data-t="others">
        货源 ({{ othersCount }})
      </view>
      <view class="kind-tab {{ viewTab === 'mine' ? 'on' : '' }}" bindtap="setViewTab" data-t="mine">
        我的求购 ({{ mine.length }})
      </view>
    </view>

    <view class="page-pad">
      <block wx:if="{{ viewTab === 'others' }}">
        <view class="grid">
          <view class="grid-cell" wx:for="{{ others }}" wx:key="id">
            <egg-card r="{{ item }}" bind:cardtap="openRes" data-id="{{ item.id }}" />
          </view>
        </view>
        <empty wx:if="{{ !others.length }}" icon="📭" text="当前没有货源" />
      </block>
      <block wx:else>
        <view class="grid">
          <view class="grid-cell" wx:for="{{ mine }}" wx:key="id">
            <egg-card r="{{ item }}" bind:cardtap="openRes" data-id="{{ item.id }}" />
          </view>
        </view>
        <empty wx:if="{{ !mine.length }}" icon="📭" text="您还没发布过求购" />
      </block>
    </view>
  </block>

  <!-- 浮动「发布」按钮（底部居中） -->
  <view class="fab" bindtap="goPublish">
    <view class="fab-plus">+</view>
    <view class="fab-label">{{ user.role === 'farm' ? '发布货源' : '发求购' }}</view>
  </view>
</block>
