.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffd84d 0%, #f6b821 35%, #fff 100%);
  padding: 60rpx 48rpx;
  box-sizing: border-box;
}
.brand { text-align: center; padding: 80rpx 0 40rpx; }
.brand-egg { font-size: 100rpx; }
.brand-name { color: #fff; font-size: 56rpx; font-weight: 800; letter-spacing: 4rpx; }
.brand-slogan { color: #fff; opacity: .9; font-size: 28rpx; margin-top: 8rpx; }

.pick-card { padding: 20rpx 0; }
.pick-title { color: #fff; font-size: 30rpx; text-align: center; margin-bottom: 24rpx; opacity: .85; }
.pick-btn {
  background: #fff; border-radius: 24rpx;
  padding: 36rpx 32rpx; margin-bottom: 24rpx;
  display: flex; align-items: center; gap: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
  transition: transform .15s;
}
.pick-btn:active { transform: scale(0.97); }
.pick-icon {
  width: 100rpx; height: 100rpx; border-radius: 24rpx;
  background: #fff7e0; color: #f6b821;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; flex-shrink: 0;
}
.pick-sell .pick-icon { background: #fff7e0; }
.pick-buy .pick-icon { background: #e6f0ff; color: #1c5bd8; }
.pick-main { font-size: 36rpx; font-weight: 700; color: #1d1d1f; }
.pick-sub { color: #8a8d93; font-size: 24rpx; margin-top: 4rpx; }

.login-card { background: #fff; border-radius: 24rpx; padding: 40rpx 32rpx; box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.08); }

.btn-wx {
  background: #07c160 !important;
  color: #fff !important;
  border: none !important;
}
.wx-icon { margin-right: 8rpx; }

.divider {
  display: flex; align-items: center;
  margin: 32rpx 0 24rpx;
  color: #b0b0b0; font-size: 22rpx;
}
.divider::before, .divider::after {
  content: ''; flex: 1; height: 1px; background: #e0e0e0;
}
.divider text { padding: 0 20rpx; }

.otp-btn {
  background: #fff7e0; color: #b78300;
  padding: 0 20rpx; min-height: 60rpx; line-height: 60rpx;
  border-radius: 16rpx; font-size: 24rpx;
  border: none;
}
.otp-btn[disabled] { background: #f0f0f0; color: #aaa; }

.login-foot { text-align: center; color: #fff; margin-top: 60rpx; opacity: .9; font-size: 24rpx; }

.modal-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.5);
  z-index: 1000; display: flex; align-items: center; justify-content: center;
}
.modal { background: #fff; border-radius: 24rpx; padding: 40rpx; width: 640rpx; }
.input-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1px solid #f0f0f0; }
.input-row .label { width: 140rpx; color: #555; font-size: 26rpx; }
.input-row input { flex: 1; }

/* 审核员测试账号入口（仅供微信审核期使用，过审后整段移除） */
.test-card {
  margin: 48rpx 40rpx 32rpx;
  background: linear-gradient(135deg, #fff7e0 0%, #ffe9a8 100%);
  border: 2rpx solid #f6b821;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
}
.test-title {
  font-size: 30rpx; font-weight: 800;
  color: #5a4810; margin-bottom: 8rpx;
}
.test-tip {
  font-size: 22rpx; color: #8a6b15;
  line-height: 1.6; margin-bottom: 16rpx;
}
.test-row {
  display: flex; align-items: center; gap: 16rpx;
  background: rgba(255,255,255,0.7);
  border-radius: 14rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}
.test-line {
  display: flex; gap: 12rpx;
  font-size: 24rpx; line-height: 1.7;
}
.test-k { color: #8a6b15; min-width: 70rpx; }
.test-v { color: #1d1d1f; font-weight: 600; }
.btn-test {
  background: #f6b821; color: #fff;
  border: none; border-radius: 999rpx;
  font-size: 24rpx; padding: 14rpx 26rpx;
  flex-shrink: 0;
}
.test-or {
  text-align: center;
  color: #8a6b15; font-size: 22rpx;
  margin: 16rpx 0 8rpx;
}

.agree-foot {
  display: flex; align-items: center; justify-content: center;
  gap: 12rpx; padding: 24rpx 32rpx;
  font-size: 22rpx; color: #8a8d93;
}
.agree-box {
  width: 28rpx; height: 28rpx; border: 2rpx solid #c0c0c0;
  border-radius: 6rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: transparent;
}
.agree-box.on { background: #f6b821; border-color: #f6b821; color: #fff; }
.agree-text .link { color: #e0a40d; }
