.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffd84d 0%, #f6b821 35%, #fff 100%);
  padding: 60rpx 48rpx;
  box-sizing: border-box;
}
.brand { text-align: center; padding: 80rpx 0 40rpx; }
.brand-egg { font-size: 100rpx; }
.brand-name { color: #fff; font-size: 56rpx; font-weight: 800; letter-spacing: 4rpx; }
.brand-slogan { color: #fff; opacity: .9; font-size: 28rpx; margin-top: 8rpx; }

.pick-card { padding: 20rpx 0; }
.pick-title { color: #fff; font-size: 30rpx; text-align: center; margin-bottom: 24rpx; opacity: .85; }
.pick-btn {
  background: #fff; border-radius: 24rpx;
  padding: 36rpx 32rpx; margin-bottom: 24rpx;
  display: flex; align-items: center; gap: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
  transition: transform .15s;
}
.pick-btn:active { transform: scale(0.97); }
.pick-icon {
  width: 100rpx; height: 100rpx; border-radius: 24rpx;
  background: #fff7e0; color: #f6b821;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; flex-shrink: 0;
}
.pick-sell .pick-icon { background: #fff7e0; }
.pick-buy .pick-icon { background: #e6f0ff; color: #1c5bd8; }
.pick-main { font-size: 36rpx; font-weight: 700; color: #1d1d1f; }
.pick-sub { color: #8a8d93; font-size: 24rpx; margin-top: 4rpx; }

.login-card { background: #fff; border-radius: 24rpx; padding: 40rpx 32rpx; box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.08); }

.otp-btn {
  background: #fff7e0; color: #b78300; padding: 10rpx 20rpx;
  border-radius: 16rpx; font-size: 24rpx;
}

.login-foot { text-align: center; color: #fff; margin-top: 60rpx; opacity: .9; font-size: 24rpx; }
