<view class="page-pad">
  <view class="card kind-banner {{ isSupply ? '' : 'demand' }}">
    <view class="kind-icon">{{ isSupply ? '🐔' : '🛒' }}</view>
    <view>
      <view class="bold" style="font-size: 32rpx;">{{ isSupply ? '发布货源' : '发布求购需求' }}</view>
      <view class="muted mt-8" style="font-size: 24rpx;">
        {{ isSupply ? '采购商竞价出价，价高者得' : '养殖场报价应标，价低者得（反向竞拍）' }}
      </view>
    </view>
  </view>

  <!-- 保证金状态条：发布时从钱包冻结一笔。可用余额够则金色 ✓，不够弹去充值 -->
  <view class="deposit-bar {{ depositPaid ? 'paid' : 'unpaid' }}" bindtap="onDepositTap">
    <view class="deposit-icon">{{ depositPaid ? '✓' : '⚠' }}</view>
    <view class="flex-1">
      <view class="deposit-title">
        {{ depositPaid ? '钱包余额可冻结 ' + depositAmount + ' 元保证金' : '可用余额不足 ' + depositAmount + ' 元，需充值' }}
      </view>
      <view class="deposit-sub">
        当前可用 ¥{{ walletAvailable }} · 发布后将冻结，订单完成后扣服务费，余款解冻
      </view>
    </view>
    <view wx:if="{{ !depositPaid }}" class="deposit-arrow">›</view>
  </view>

  <view class="card">
    <view class="input-row"><view class="label">标题</view><input value="{{ form.title }}" data-k="title" bindinput="onInput" bindblur="onInput" placeholder="{{ isSupply ? '如：青州散养土鸡蛋·30 箱' : '如：求购红壳鸡蛋 20 箱·北京自提' }}" /></view>
    <view class="input-row"><view class="label">省份</view>
      <picker bindchange="pickProvince" value="{{ provinceIndex }}" range="{{ provinces }}">
        <view class="picker-val">{{ provinces[provinceIndex] }} ▾</view>
      </picker>
    </view>
    <view class="input-row"><view class="label">具体地区</view><input value="{{ form.region }}" data-k="region" bindinput="onInput" bindblur="onInput" placeholder="如：山东青州 / 河南信阳" /></view>

    <!-- 定位信息（可选） -->
    <view class="input-row loc-row">
      <view class="label">📍 定位</view>
      <view class="flex-1">
        <block wx:if="{{ locText }}">
          <view class="loc-main">{{ locText }}</view>
          <view wx:if="{{ locSub }}" class="loc-sub muted">{{ locSub }}</view>
        </block>
        <view wx:else class="loc-main muted">未定位（可选）</view>
      </view>
      <view class="loc-actions">
        <text class="loc-act" bindtap="pickLocation">{{ locText ? '修改' : '定位' }}</text>
        <text wx:if="{{ locText }}" class="loc-act loc-act-del" bindtap="clearLocation">清除</text>
      </view>
    </view>

    <!-- 先蛋色 -->
    <view class="input-row">
      <view class="label">蛋色</view>
      <radio-group bindchange="pickColor" style="display: flex; gap: 24rpx;">
        <label><radio value="红壳" checked="{{ form.egg_color === '红壳' }}" />红壳</label>
        <label><radio value="粉壳" checked="{{ form.egg_color === '粉壳' }}" />粉壳</label>
        <label><radio value="杂色" checked="{{ form.egg_color === '杂色' }}" />杂色</label>
      </radio-group>
    </view>

    <!-- 再鸡种 -->
    <view class="input-row"><view class="label">鸡种</view><input value="{{ form.chicken_breed }}" data-k="chicken_breed" bindinput="onInput" bindblur="onInput" placeholder="如：海兰褐 / 罗曼粉 / 笨鸡" /></view>

    <view wx:if="{{ isSupply }}" class="input-row">
      <view class="label">养殖规模</view>
      <input type="digit" value="{{ form.farm_size_wan }}" data-k="farm_size_wan" bindinput="onInput" bindblur="onInput" placeholder="如 1.5" />
      <text class="muted" style="margin-left: 8rpx;">万只</text>
    </view>

    <!-- 规格码数：单箱净重区间 -->
    <view class="input-row">
      <view class="label">单箱净重</view>
      <input type="digit" value="{{ form.weight_min }}" data-k="weight_min" bindinput="onInput" bindblur="onInput" placeholder="如 38" style="width: 120rpx;" />
      <text class="muted" style="margin: 0 8rpx;">—</text>
      <input type="digit" value="{{ form.weight_max }}" data-k="weight_max" bindinput="onInput" bindblur="onInput" placeholder="如 42" style="width: 120rpx;" />
      <text class="muted" style="margin-left: 8rpx;">斤/箱</text>
    </view>

    <view wx:if="{{ isSupply }}" class="input-row"><view class="label">蛋壳质量</view><input value="{{ form.shell_quality }}" data-k="shell_quality" bindinput="onInput" bindblur="onInput" placeholder="如：硬壳-无裂纹" /></view>

    <!-- 次品率 -->
    <view wx:if="{{ isSupply }}" class="input-row">
      <view class="label">次品率</view>
      <input type="digit" value="{{ form.defect_rate }}" data-k="defect_rate" bindinput="onInput" bindblur="onInput" placeholder="如 0.5" style="width: 140rpx;" />
      <text class="muted" style="margin-left: 8rpx;">%</text>
    </view>
    <view wx:if="{{ isSupply }}" class="input-row"><view class="label">鲜度</view><input type="number" value="{{ form.freshness_days }}" data-k="freshness_days" bindinput="onInput" bindblur="onInput" placeholder="x 天内" /></view>

    <view class="input-row">
      <view class="label">数量</view>
      <input type="digit" value="{{ form.quantity }}" data-k="quantity" bindinput="onInput" bindblur="onInput" placeholder="如 1" />
      <text class="muted" style="margin-left: 8rpx;">车</text>
    </view>

    <!-- 车型快速档 -->
    <view class="quick-row">
      <view class="quick-tip">常用车型（点击填入）</view>
      <view class="quick-chips">
        <view class="quick-chip" wx:for="{{ truckPresets }}" wx:key="value" bindtap="pickTruck" data-v="{{ item.value }}">
          <text class="quick-val">{{ item.value }} m 车</text>
          <text class="quick-sub">≈ {{ item.boxes }} 箱</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="input-row">
      <view class="label">{{ isSupply ? '起拍价' : '心理价上限' }}</view>
      <input type="digit" value="{{ form.start_price }}" data-k="start_price" bindinput="onInput" bindblur="onInput" placeholder="{{ isSupply ? '如 85' : '如 95' }}" />
      <view class="muted" style="margin-left: 8rpx;">元/箱</view>
    </view>
    <view class="input-row">
      <view class="label">{{ isSupply ? '加价幅度' : '降价幅度' }}</view>
      <input type="digit" value="{{ form.min_increment }}" data-k="min_increment" bindinput="onInput" bindblur="onInput" placeholder="≥ 2" />
      <view class="muted" style="margin-left: 8rpx;">元/箱</view>
    </view>
    <view class="input-row">
      <view class="label">竞拍时长</view>
      <radio-group bindchange="pickDur" style="display: flex; gap: 24rpx;">
        <label><radio value="1" checked="{{ form.duration_hours == 1 }}" />1 小时</label>
        <label><radio value="2" checked="{{ form.duration_hours == 2 }}" />2 小时</label>
        <label><radio value="3" checked="{{ form.duration_hours == 3 }}" />3 小时</label>
      </radio-group>
    </view>
  </view>

  <view class="card">
    <view class="input-row"><view class="label">描述</view><textarea value="{{ form.description }}" data-k="description" bindinput="onInput" bindblur="onInput" placeholder="{{ isSupply ? '饲养方式、检疫情况、发货时效...' : '需求详情、自提/送货、付款方式...' }}" auto-height /></view>

    <view class="upload-block">
      <view class="upload-title">图片（最多 9 张，拍照或从相册选择）</view>
      <view class="upload-grid">
        <view wx:for="{{ photos }}" wx:key="*this" class="upload-thumb">
          <image src="{{ item }}" mode="aspectFill" bindtap="preview" data-url="{{ item }}" />
          <view class="upload-del" catchtap="delPhoto" data-i="{{ index }}">×</view>
        </view>
        <view wx:if="{{ photos.length < 9 }}" class="upload-add" bindtap="addPhoto">+</view>
      </view>
    </view>

    <view wx:if="{{ isSupply }}" class="upload-block">
      <view class="upload-title">视频介绍（可选，鸡场实景 / 蛋品展示，60s 内）</view>
      <view wx:if="{{ video }}" class="video-preview">
        <video src="{{ video }}" controls style="width: 100%; height: 380rpx; border-radius: 12rpx;"></video>
        <view class="video-del" bindtap="delVideo">删除视频</view>
      </view>
      <view wx:else class="upload-add" style="width: 100%; height: 200rpx;" bindtap="addVideo">+ 上传视频</view>
    </view>
  </view>

  <button class="btn mt-16" bindtap="submit" loading="{{ loading }}">
    立即发布{{ isSupply ? '货源' : '求购' }}
  </button>
</view>
