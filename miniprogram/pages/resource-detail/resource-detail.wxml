<view wx:if="{{ r }}">
  <swiper class="banner" autoplay circular indicator-dots indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#fff">
    <swiper-item wx:for="{{ photos }}" wx:key="*this">
      <image class="banner-img" src="{{ item }}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <view class="card" style="margin: -32rpx 24rpx 24rpx; position: relative; z-index: 2;">
    <view class="row-between">
      <view>
        <view class="muted">当前价</view>
        <view class="price-l">¥{{ r.current_price }}</view>
        <view class="muted">起拍 ¥{{ r.start_price }} · 加价 ¥{{ r.min_increment }}</view>
      </view>
      <view style="text-align: right;">
        <view class="muted">{{ r.status === 'auctioning' ? '剩余' : statusLabel }}</view>
        <view wx:if="{{ r.status === 'auctioning' }}" class="mt-8"><countdown end-at="{{ r.end_at }}" bindend="onEnd" /></view>
        <view wx:if="{{ r.extend_count > 0 }}" class="muted mt-8">已延时 {{ r.extend_count }} 次</view>
      </view>
    </view>
    <view class="bold mt-16" style="font-size: 32rpx;">{{ r.title }}</view>
    <view class="mt-8">
      <text wx:if="{{ r.egg_color }}" class="tag">{{ r.egg_color }}</text>
      <text wx:if="{{ r.weight_spec }}" class="tag tag-b">{{ r.weight_spec }}</text>
      <text wx:if="{{ r.region }}" class="tag tag-g">{{ r.region }}</text>
      <text wx:if="{{ r.chicken_breed }}" class="tag tag-b">{{ r.chicken_breed }}</text>
    </view>
  </view>

  <view class="card" style="margin: 0 24rpx 24rpx;">
    <view class="section-title" style="margin: 0 0 16rpx;">参数明细</view>
    <view class="kv"><text class="muted">数量</text><text>{{ r.quantity }} 枚</text></view>
    <view class="kv"><text class="muted">蛋壳质量</text><text>{{ r.shell_quality || '-' }}</text></view>
    <view class="kv"><text class="muted">鲜度</text><text>{{ r.freshness_days ? r.freshness_days + ' 天内' : '-' }}</text></view>
    <view class="kv"><text class="muted">规模</text><text>{{ r.farm_size ? r.farm_size + ' 只' : '-' }}</text></view>
    <view class="kv"><text class="muted">养殖场</text><text>{{ r.farm.name }}</text></view>
    <view wx:if="{{ r.description }}" class="mt-16" style="line-height: 1.7;">{{ r.description }}</view>
  </view>

  <view class="card" style="margin: 0 24rpx 24rpx;">
    <view class="row-between section-title" style="margin: 0 0 16rpx;">
      <text>出价记录 ({{ bids.length }})</text>
      <text class="muted">{{ r.bidder_count }} 位参与</text>
    </view>
    <empty wx:if="{{ !bids.length }}" icon="💰" text="暂无出价，期待第一次出价" />
    <view wx:for="{{ bids }}" wx:key="id" class="bid-row">
      <view>
        <text>{{ item.bidder_name }}</text>
        <text wx:if="{{ item.is_auto }}" class="muted"> (自动)</text>
        <view class="muted" style="font-size: 22rpx;">{{ item.timeText }}</view>
      </view>
      <text class="price">¥{{ item.price }}</text>
    </view>
  </view>

  <view style="height: 160rpx;"></view>

  <!-- 采购商：出价栏 -->
  <view wx:if="{{ user.role === 'buyer' && r.status === 'auctioning' }}" class="fixed-bottom-bar">
    <button class="btn-plain" style="padding: 12rpx 24rpx; flex-shrink: 0;" bindtap="openAuto">⚙ 自动</button>
    <input class="bid-input" type="digit" model:value="{{ bidPrice }}" placeholder="≥ ¥{{ minBid }}" />
    <button class="btn" style="flex: 1; padding: 14rpx 0;" bindtap="placeBid" loading="{{ bidding }}">出价</button>
  </view>

  <!-- 养殖场：管理栏 -->
  <view wx:if="{{ user.role === 'farm' && isMine && r.status === 'auctioning' && bids.length === 0 }}" class="fixed-bottom-bar">
    <button class="btn-plain btn-danger" style="flex: 1; padding: 14rpx 0; color: #ee0a24; border-color: #ee0a24;" bindtap="cancel">取消竞拍</button>
  </view>

  <view wx:if="{{ user.role !== 'buyer' && (!isMine || r.status !== 'auctioning' || bids.length > 0) }}" class="fixed-bottom-bar">
    <button class="btn-plain" style="flex: 1;" disabled>{{ statusLabel }}</button>
  </view>
</view>

<!-- 自动出价弹窗 -->
<view wx:if="{{ showAuto }}" class="modal-mask" bindtap="closeAuto">
  <view class="modal" catchtap="noop">
    <view class="bold">设置自动出价</view>
    <view class="muted mt-8">设置最高心理价位，系统将以最低加价帮您出价，直到拍下或超出心理价。</view>
    <view class="input-row mt-16"><view class="label">最高出价</view><input type="digit" model:value="{{ autoMax }}" placeholder="≥ {{ minBid }}" /></view>
    <view class="row mt-16" style="gap: 16rpx;">
      <button class="btn-plain flex-1" bindtap="closeAuto">取消</button>
      <button class="btn flex-1" bindtap="setAuto">确认开启</button>
    </view>
  </view>
</view>
