.bell { position: relative; color: #fff; font-size: 40rpx; }
.bell-badge {
  position: absolute; top: -8rpx; right: -16rpx;
  background: #ee0a24; color: #fff;
  padding: 2rpx 10rpx; border-radius: 16rpx; font-size: 20rpx;
}

.search-wrap {
  margin-top: 24rpx; background: rgba(255,255,255,0.85);
  padding: 16rpx 24rpx; border-radius: 999rpx;
  color: #8a8d93; font-size: 26rpx;
}

.quick-grid {
  display: flex; gap: 16rpx;
  padding: 32rpx 24rpx 0;
  position: relative; z-index: 2;
}
.quick {
  flex: 1; background: #fff; border-radius: 16rpx;
  padding: 20rpx 0; text-align: center;
  font-size: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.quick-icon { font-size: 40rpx; margin-bottom: 4rpx; }

.stat-grid {
  display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx;
  padding: 24rpx;
}
.stat-cell { background: #fff; border-radius: 16rpx; padding: 24rpx 12rpx; text-align: center; }
.stat-v { font-size: 36rpx; font-weight: 700; }
.stat-l { font-size: 22rpx; color: #8a8d93; margin-top: 4rpx; }
