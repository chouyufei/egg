.ec { padding: 0; overflow: hidden; }
.ec-img-wrap { position: relative; width: 100%; height: 320rpx; background: #f6b821; }
.ec-img { width: 100%; height: 320rpx; }
.ec-kind {
  position: absolute; top: 16rpx; left: 16rpx;
  padding: 6rpx 16rpx; border-radius: 8rpx;
  font-size: 24rpx; font-weight: 700; color: #fff;
}
.ec-kind.supply { background: #f6b821; }
.ec-kind.demand { background: #1c5bd8; }
.ec-status {
  position: absolute; top: 16rpx; left: 130rpx;
  padding: 4rpx 14rpx; border-radius: 16rpx; font-size: 22rpx;
}
.ec-time {
  position: absolute; top: 16rpx; right: 16rpx;
  background: rgba(0,0,0,0.55); color: #fff;
  padding: 6rpx 12rpx; border-radius: 16rpx; font-size: 22rpx;
}
.ec-body { padding: 20rpx 24rpx 24rpx; }
