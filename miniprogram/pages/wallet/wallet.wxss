.hero {
  padding: 56rpx 32rpx 80rpx;
}
.big-bal {
  font-size: 64rpx; font-weight: 800;
  color: #fff; margin-top: 8rpx;
  letter-spacing: 2rpx;
}

.sub-tabs {
  display: flex; background: #fff;
  border-bottom: 1px solid #f0f0f0;
}
.sub-tab {
  flex: 1; text-align: center;
  padding: 24rpx 0; font-size: 28rpx; color: #8a8d93;
  position: relative;
}
.sub-tab.on { color: #1d1d1f; font-weight: 700; }
.sub-tab.on::after {
  content: ''; position: absolute; bottom: 0; left: 30%; right: 30%;
  height: 6rpx; background: #f6b821; border-radius: 3rpx;
}

.tx-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 0; border-bottom: 1px solid #f0f0f0;
}
.tx-row:last-child { border-bottom: none; }
.tx-in  { color: #06883b; font-weight: 700; font-size: 30rpx; }
.tx-out { color: #ee0a24; font-weight: 700; font-size: 30rpx; }
.tx-lock   { color: #b78300; font-weight: 600; font-size: 26rpx; background: #fff7e0; padding: 6rpx 14rpx; border-radius: 12rpx; }
.tx-unlock { color: #1c5bd8; font-weight: 600; font-size: 26rpx; background: #e6f0ff; padding: 6rpx 14rpx; border-radius: 12rpx; }

.legend {
  display: flex; flex-wrap: wrap; gap: 16rpx;
  padding: 16rpx 24rpx; background: #fff;
  font-size: 22rpx; color: #8a8d93;
}
.lg-item { display: inline-flex; align-items: center; gap: 6rpx; }
