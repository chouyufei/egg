.sm-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffd84d 0%, #f6b821 35%, #fff 100%);
  padding: 60rpx 48rpx;
  box-sizing: border-box;
}
.sm-brand { text-align: center; padding: 100rpx 0 60rpx; }
.sm-egg { font-size: 100rpx; }
.sm-name { color: #fff; font-size: 56rpx; font-weight: 800; letter-spacing: 4rpx; }
.sm-sub { color: #fff; opacity: .9; font-size: 30rpx; margin-top: 16rpx; }

.sm-card {
  background: #fff; border-radius: 24rpx;
  padding: 40rpx 32rpx; margin-bottom: 28rpx;
  display: flex; align-items: center; gap: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
  transition: transform .15s;
}
.sm-card:active { transform: scale(0.97); }
.sm-icon {
  width: 100rpx; height: 100rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; flex-shrink: 0;
}
.sm-icon-sell { background: #fff7e0; }
.sm-icon-buy { background: #e6f0ff; }
.sm-main { font-size: 38rpx; font-weight: 700; color: #1d1d1f; }
.sm-tip { color: #8a8d93; font-size: 24rpx; margin-top: 6rpx; }
.sm-arrow { color: #b0b0b0; font-size: 48rpx; }
.flex-1 { flex: 1; min-width: 0; }
.sm-foot { margin-top: 60rpx; color: rgba(255,255,255,0.85); font-size: 24rpx; }
