<page-meta page-style="{{ pageStyle }}"></page-meta>

<view class="page-pad">
  <!-- 游客：未登录提示 -->
  <view wx:if="{{ isGuest }}" class="card text-c" style="padding: 80rpx 32rpx;">
    <view style="font-size: 80rpx;">📦</view>
    <view class="bold mt-8">登录后查看您的订单</view>
    <view class="muted mt-8">游客可浏览货源与求购，登录后才能下单、查看订单</view>
    <button class="btn mt-16" bindtap="goLogin">登录 / 注册</button>
  </view>

  <view wx:for="{{ orders }}" wx:key="id" class="card order-card" bindtap="open" data-id="{{ item.id }}">
    <!-- 顶部一行大色块标识：买 / 卖，整张卡左侧也描一条色边强化 -->
    <view class="{{ item.sideCls }}">{{ item.sideLabel }}</view>
    <view class="row-between mt-8">
      <text class="bold">订单 {{ item.order_no || ('#' + item.id) }}</text>
      <text class="tag {{ item.statusCls }}">{{ item.statusText }}</text>
    </view>
    <view class="row mt-8" style="gap: 16rpx;">
      <image class="thumb" src="{{ item.cover }}" mode="aspectFill" />
      <view class="flex-1">
        <view class="ellipsis">{{ item.resource.title }}</view>
        <view class="muted">{{ item.otherLabel }}：{{ item.otherName }}</view>
        <view class="row-between mt-8">
          <text class="price">¥{{ item.final_price }}</text>
          <text class="muted">{{ item.timeText }}</text>
        </view>
      </view>
    </view>
  </view>
  <empty wx:if="{{ !orders.length && !isGuest }}" icon="📦" text="暂无订单" />
</view>
