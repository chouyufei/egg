.wrap {
  position: relative;
  width: 100%; height: 100vh;
  background: #f5f6f8;
}
.map {
  width: 100%; height: 64vh;
}
.info-card {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 32rpx 28rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.08);
}
.info-row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 16rpx 0;
}
.info-icon {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  color: #fff; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.info-title { font-size: 28rpx; font-weight: 700; color: #1d1d1f; }
.info-sub { font-size: 22rpx; margin-top: 4rpx; font-family: 'SF Mono', Menlo, monospace; }

.dist-line {
  display: flex; align-items: center; gap: 12rpx;
  padding: 8rpx 32rpx;
}
.dist-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #f6b821; }
.dist-bar { flex: 1; height: 2rpx; background: linear-gradient(90deg, #f6b821, transparent, #f6b821); }
.dist-text { font-size: 24rpx; color: #5a4810; }
