<view wx:if="{{ order }}" class="page-pad">
  <view class="card">
    <view class="row-between">
      <text class="bold">订单 #{{ order.id }}</text>
      <text class="tag {{ statusCls }}">{{ statusText }}</text>
    </view>
    <view class="kv mt-16"><text class="muted">资源</text><text>{{ order.resource.title }}</text></view>
    <view class="kv"><text class="muted">成交价</text><text class="price">¥{{ order.final_price }}</text></view>
    <view class="kv"><text class="muted">数量</text><text>{{ order.quantity }} {{ (order.resource && order.resource.unit_size) || '车' }}</text></view>
    <view class="kv"><text class="muted">{{ otherLabel }}</text><text>{{ otherName }}</text></view>
    <view class="kv"><text class="muted">联系电话</text><text>{{ otherPhone }}</text></view>
    <view wx:if="{{ distText }}" class="kv kv-link" catchtap="openRouteMap">
      <text class="muted">📍 距离</text>
      <view>距您 {{ distText }} <text class="muted" style="font-size: 22rpx;">查看路线 ›</text></view>
    </view>
  </view>

  <!-- 客服企业微信二维码：成交后下发，买卖双方都加客服后由客服拉群 -->
  <view wx:if="{{ serviceQr.url }}" class="card qr-card">
    <view class="qr-title">📲 添加客服企业微信</view>
    <view class="qr-sub">{{ serviceQr.owner || '凤伯乐 · 客服' }}</view>
    <image src="{{ serviceQr.url }}" mode="aspectFit" class="qr-img" bindtap="previewQr" />
    <view class="qr-tip">
      买卖双方都扫码加好友后，客服会拉建沟通群，负责对接发货、对货、回款等流程。
    </view>
    <view class="row" style="gap: 16rpx; margin-top: 16rpx;">
      <button class="btn-plain flex-1" bindtap="previewQr">查看大图</button>
      <button class="btn flex-1" bindtap="saveQr">保存到相册</button>
    </view>
  </view>

  <view class="card">
    <view class="section-title" style="margin: 0 0 16rpx;">沟通群</view>
    <view wx:if="{{ !order.group_id }}" class="text-c" style="padding: 20rpx 0;">
      <view class="muted mt-8">{{ user.role === 'buyer' ? '中标后请尽快建群联系养殖场' : '等待采购商建群，或可主动建群' }}</view>
      <button class="btn mt-16" bindtap="createGroup">建立沟通群</button>
    </view>
    <view wx:else>
      <view class="muted">群编号：{{ order.group_id }}</view>
      <scroll-view scroll-y class="chat-box">
        <view wx:for="{{ chats }}" wx:key="id" class="chat-row {{ item.mine ? 'mine' : '' }}">
          <view class="chat-meta">{{ item.sender_name }} · {{ item.timeText }}</view>
          <view class="chat-bubble">{{ item.content }}</view>
        </view>
        <view wx:if="{{ !chats.length }}" class="muted text-c" style="padding: 40rpx 0;">还没有消息</view>
      </scroll-view>
      <view class="row mt-8" style="gap: 12rpx;">
        <input class="bid-input" model:value="{{ msg }}" placeholder="输入消息..." bindconfirm="send" />
        <button class="btn" style="flex-shrink: 0; padding: 14rpx 32rpx;" bindtap="send">发送</button>
      </view>
    </view>
  </view>

  <view wx:if="{{ user.role === 'buyer' && (order.status === 'communicating' || order.status === 'pending_group') }}" class="card">
    <button class="btn" bindtap="confirm">确认收货</button>
    <view class="muted text-c mt-8">7 天未操作系统自动确认</view>
    <button class="btn-plain mt-8" bindtap="openDispute" style="color: #ee0a24; border-color: #ee0a24;">货不对板，发起纠纷</button>
  </view>
</view>

<view wx:if="{{ showDispute }}" class="modal-mask" bindtap="closeDispute">
  <view class="modal" catchtap="noop">
    <view class="bold">发起纠纷</view>
    <view class="input-row mt-8"><view class="label">类型</view><input value="{{ dispute.type }}" data-k="type" bindinput="onDisputeInput" bindblur="onDisputeInput" placeholder="如：货不对板/数量不足" /></view>
    <view class="input-row"><view class="label">描述</view><textarea value="{{ dispute.description }}" data-k="description" bindinput="onDisputeInput" bindblur="onDisputeInput" placeholder="请详细描述" auto-height /></view>
    <view class="row mt-16" style="gap: 16rpx;">
      <button class="btn-plain flex-1" bindtap="closeDispute">取消</button>
      <button class="btn flex-1" bindtap="submitDispute">提交</button>
    </view>
  </view>
</view>
