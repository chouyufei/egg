.kv { display: flex; justify-content: space-between; padding: 12rpx 0; font-size: 28rpx; }

.qr-card {
  background: linear-gradient(135deg, #fff7e0 0%, #ffe9a8 100%);
  border: 2rpx solid #f6b821;
  text-align: center;
}
.qr-title { font-size: 32rpx; font-weight: 800; color: #1d1d1f; }
.qr-sub { font-size: 24rpx; color: #b78300; margin-top: 6rpx; }
.qr-img {
  width: 420rpx; height: 420rpx;
  margin: 24rpx auto;
  display: block;
  background: #fff; border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}
.qr-tip {
  font-size: 24rpx; color: #5a4810; line-height: 1.6;
  background: rgba(255,255,255,0.5); border-radius: 12rpx;
  padding: 16rpx; margin-top: 8rpx;
}

.chat-box {
  height: 500rpx; background: #f5f6f8; border-radius: 16rpx;
  padding: 16rpx; margin-top: 16rpx;
}
.chat-row { margin: 12rpx 0; }
.chat-meta { color: #8a8d93; font-size: 22rpx; }
.chat-bubble {
  display: inline-block; max-width: 70%;
  padding: 14rpx 20rpx; border-radius: 18rpx; background: #fff;
  font-size: 28rpx;
}
.chat-row.mine { text-align: right; }
.chat-row.mine .chat-bubble { background: #f6b821; color: #fff; }

/* 系统消息（居中、淡黄底） */
.chat-sys { text-align: center; margin: 16rpx 0; }
.chat-sys-meta { color: #b78300; font-size: 22rpx; margin-bottom: 8rpx; }
.chat-sys-bubble {
  display: inline-block; max-width: 86%; text-align: left;
  background: #fff7e0; border: 2rpx solid #f6b821;
  padding: 16rpx 20rpx; border-radius: 16rpx;
  font-size: 26rpx; color: #1d1d1f; line-height: 1.5;
}
.chat-sys-img {
  display: block; width: 360rpx; height: 360rpx;
  margin: 12rpx auto 4rpx; background: #fff; border-radius: 12rpx;
}
.chat-sys-tip { font-size: 20rpx; color: #8a6b15; text-align: center; }

.bid-input {
  flex: 1; background: #f5f6f8; border-radius: 999rpx;
  padding: 14rpx 24rpx; font-size: 28rpx;
}

.modal-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.5);
  z-index: 1000; display: flex; align-items: center; justify-content: center;
}
.modal { background: #fff; border-radius: 24rpx; padding: 40rpx; width: 600rpx; }
.input-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1px solid #f0f0f0; }
.input-row .label { width: 140rpx; color: #555; font-size: 26rpx; }
.input-row input, .input-row textarea { flex: 1; }
