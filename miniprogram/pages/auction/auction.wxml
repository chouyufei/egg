<!-- 采购商：浏览全部 + 我的竞拍 -->
<block wx:if="{{ user.role === 'buyer' }}">
  <view class="tabs">
    <view class="tab {{ tab === 'all' ? 'on' : '' }}" bindtap="setTab" data-t="all">浏览全部</view>
    <view class="tab {{ tab === 'mine' ? 'on' : '' }}" bindtap="setTab" data-t="mine">我的竞拍</view>
  </view>

  <block wx:if="{{ tab === 'all' }}">
    <view class="page-pad">
      <view class="search-row">
        <input class="search-input" model:value="{{ filters.keyword }}" placeholder="搜索标题或描述" bindconfirm="reload" />
        <view class="btn-plain" style="padding: 6rpx 28rpx;" bindtap="reload">筛选</view>
      </view>
      <view class="filter-row">
        <picker bindchange="pickSort" value="{{ sortIndex }}" range="{{ sortOptions }}" range-key="label">
          <view class="filter-chip">排序：{{ sortOptions[sortIndex].label }} ▾</view>
        </picker>
        <picker bindchange="pickColor" value="{{ colorIndex }}" range="{{ colorOptions }}">
          <view class="filter-chip">蛋色：{{ colorOptions[colorIndex] }} ▾</view>
        </picker>
      </view>
      <egg-card wx:for="{{ all }}" wx:key="id" r="{{ item }}" bindtap="openRes" data-id="{{ item.id }}" />
      <empty wx:if="{{ !all.length }}" icon="🔍" text="未找到资源" />
    </view>
  </block>

  <block wx:else>
    <view class="tabs sub-tabs">
      <view class="tab {{ sub === 'active' ? 'on' : '' }}" bindtap="setSub" data-s="active">进行中</view>
      <view class="tab {{ sub === 'won' ? 'on' : '' }}" bindtap="setSub" data-s="won">已中标</view>
      <view class="tab {{ sub === 'lost' ? 'on' : '' }}" bindtap="setSub" data-s="lost">未中标</view>
    </view>
    <view class="page-pad">
      <view wx:for="{{ filteredMine }}" wx:key="id" class="card row" bindtap="openRes" data-id="{{ item.id }}">
        <image class="thumb" src="{{ item.photos[0] || 'https://placehold.co/100x100/f6b821/fff?text=Egg' }}" mode="aspectFill" />
        <view class="flex-1" style="margin-left: 20rpx;">
          <view class="bold ellipsis">{{ item.title }}</view>
          <view class="mt-8">
            <text class="tag {{ item.leading ? 'tag-g' : 'tag-r' }}">{{ item.statusText }}</text>
            <text wx:if="{{ item.region }}" class="tag tag-b">{{ item.region }}</text>
          </view>
          <view class="row-between mt-8">
            <text class="price">¥{{ item.current_price }}</text>
            <text class="muted">{{ item.timeText }}</text>
          </view>
        </view>
      </view>
      <empty wx:if="{{ !filteredMine.length }}" icon="🔥" text="暂无记录" />
    </view>
  </block>
</block>

<!-- 养殖场：我的资源（按状态分类） -->
<block wx:if="{{ user.role === 'farm' }}">
  <view class="tabs">
    <view class="tab {{ farmTab === 'all' ? 'on' : '' }}" bindtap="setFarmTab" data-t="all">全部</view>
    <view class="tab {{ farmTab === 'auctioning' ? 'on' : '' }}" bindtap="setFarmTab" data-t="auctioning">竞拍中</view>
    <view class="tab {{ farmTab === 'sold' ? 'on' : '' }}" bindtap="setFarmTab" data-t="sold">已成交</view>
    <view class="tab {{ farmTab === 'failed' ? 'on' : '' }}" bindtap="setFarmTab" data-t="failed">已流拍</view>
  </view>
  <view class="page-pad">
    <egg-card wx:for="{{ farmResources }}" wx:key="id" r="{{ item }}" bindtap="openRes" data-id="{{ item.id }}" />
    <empty wx:if="{{ !farmResources.length }}" icon="📭" text="暂无资源" />
  </view>
</block>

<block wx:if="{{ user.role === 'admin' }}">
  <view class="empty" style="margin-top: 40rpx;">管理员请使用 Web 后台</view>
</block>
