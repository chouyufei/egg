page {
  background: #f5f6f8;
  color: #1d1d1f;
  font-size: 28rpx;
  line-height: 1.5;
}

.page-pad { padding: 24rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.gap-8 { gap: 16rpx; }
.flex-1 { flex: 1; min-width: 0; }
.muted { color: #8a8d93; font-size: 24rpx; }
.brand-text { color: #e0a40d; font-weight: 600; }
.price { color: #ee0a24; font-weight: 700; }
.price-l { color: #ee0a24; font-weight: 800; font-size: 44rpx; }
.bold { font-weight: 600; }
.text-c { text-align: center; }
.mt-8 { margin-top: 16rpx; }
.mt-16 { margin-top: 32rpx; }
.mt-24 { margin-top: 48rpx; }
.ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.hero {
  background: linear-gradient(135deg, #ffd84d 0%, #f6b821 50%, #f08a00 100%);
  color: #fff;
  padding: 36rpx 32rpx 56rpx;
  border-radius: 0 0 36rpx 36rpx;
  margin-bottom: -32rpx;
}
.hero-title { font-size: 40rpx; font-weight: 800; letter-spacing: 2rpx; }
.hero-sub { opacity: .9; font-size: 26rpx; margin-top: 6rpx; }

.section-title {
  font-size: 30rpx; font-weight: 700; margin: 28rpx 24rpx 12rpx;
  display: flex; align-items: center;
}
.section-title::before {
  content: ''; display: inline-block; width: 6rpx; height: 28rpx;
  background: #f6b821; border-radius: 3rpx; margin-right: 12rpx;
}

.tag {
  display: inline-block; padding: 4rpx 14rpx; border-radius: 16rpx;
  font-size: 22rpx; border: 1px solid #f6b821; color: #b78300; background: #fff7e0;
  margin-right: 10rpx;
}
.tag-g { color: #06883b; background: #e7f7eb; border-color: #06883b; }
.tag-b { color: #1c5bd8; background: #e6f0ff; border-color: #1c5bd8; }
.tag-r { color: #c61212; background: #ffeaea; border-color: #ee0a24; }
.tag-d { color: #666; background: #f0f0f0; border-color: #ccc; }

.btn {
  background: #f6b821; color: #fff; border: none;
  border-radius: 999rpx; font-size: 30rpx; padding: 18rpx 0;
  text-align: center; font-weight: 600;
}
.btn[disabled] { background: #ccc; color: #fff; }
.btn-plain {
  background: #fff; color: #f6b821; border: 2rpx solid #f6b821;
  border-radius: 999rpx; font-size: 28rpx; padding: 14rpx 0;
  text-align: center;
}
.btn-danger { background: #ee0a24; color: #fff; border-color: #ee0a24; }

.fixed-bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 16rpx 24rpx; background: #fff;
  border-top: 1px solid #ececec;
  display: flex; align-items: center; gap: 16rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.empty {
  padding: 120rpx 0; text-align: center; color: #8a8d93;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }

/* 两列宫格容器：纯百分比 + justify-content space-between
   避免 calc() 在部分 Android XWeb 上失效导致单列 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-cell {
  width: 49%;
  margin-bottom: 16rpx;
}
/* 兜底：cell 个数为奇数时最后一个不被拉伸 */
.grid::after {
  content: '';
  width: 49%;
}

.input-row {
  display: flex; align-items: center; padding: 24rpx 0;
  border-bottom: 1px solid #f0f0f0;
}
.input-row .label { width: 180rpx; color: #1d1d1f; }
.input-row input, .input-row textarea {
  flex: 1; padding: 0; background: transparent; font-size: 28rpx;
}

.cd {
  display: inline-flex; gap: 6rpx; font-family: 'SF Mono', Menlo, monospace;
}
.cd-box {
  background: #1d1d1f; color: #ffd84d;
  padding: 4rpx 10rpx; border-radius: 6rpx; font-size: 24rpx;
  font-weight: 700;
}
