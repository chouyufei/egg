.kind-banner {
  display: flex; align-items: center; gap: 20rpx;
  background: linear-gradient(135deg, #fff7e0 0%, #ffe9a8 100%);
}
.kind-banner.demand {
  background: linear-gradient(135deg, #e6f0ff 0%, #c5d9ff 100%);
}
.kind-icon { font-size: 64rpx; }
.picker-val { font-size: 28rpx; color: #1d1d1f; }

.upload-block { padding: 24rpx 0; }
.upload-title { font-size: 26rpx; color: #555; margin-bottom: 16rpx; }
.upload-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.upload-thumb, .upload-add {
  width: 160rpx; height: 160rpx; border-radius: 12rpx;
  position: relative;
}
.upload-thumb image { width: 100%; height: 100%; border-radius: 12rpx; }
.upload-del {
  position: absolute; top: -10rpx; right: -10rpx;
  width: 40rpx; height: 40rpx; line-height: 36rpx;
  border-radius: 50%; background: #ee0a24; color: #fff;
  text-align: center; font-size: 28rpx; font-weight: 700;
}
.upload-add {
  background: #f5f6f8; border: 2rpx dashed #d0d0d0;
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; color: #b0b0b0;
}
.video-preview { position: relative; }
.video-del {
  display: inline-block; margin-top: 12rpx;
  font-size: 24rpx; color: #ee0a24;
  padding: 4rpx 12rpx; border: 1px solid #ee0a24; border-radius: 8rpx;
}

.deposit-bar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 28rpx; border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.deposit-bar.paid {
  background: #e7f7eb; border: 2rpx solid #06883b;
}
.deposit-bar.unpaid {
  background: #fff7e0; border: 2rpx solid #f6b821;
}
.deposit-icon {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 700; color: #fff; flex-shrink: 0;
}
.deposit-bar.paid .deposit-icon { background: #06883b; }
.deposit-bar.unpaid .deposit-icon { background: #f6b821; }
.deposit-title { font-size: 28rpx; font-weight: 700; color: #1d1d1f; }
.deposit-bar.paid .deposit-title { color: #06883b; }
.deposit-bar.unpaid .deposit-title { color: #b78300; }
.deposit-sub { font-size: 22rpx; color: #8a8d93; margin-top: 4rpx; }
.deposit-arrow { font-size: 36rpx; color: #b78300; }

.quick-row { padding: 16rpx 0 8rpx; }
.quick-tip { font-size: 24rpx; color: #8a8d93; margin-bottom: 12rpx; }
.quick-chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.quick-chip {
  display: flex; flex-direction: column; align-items: center;
  background: #fff7e0; border: 2rpx solid #f6b821;
  border-radius: 16rpx; padding: 12rpx 20rpx;
  min-width: 140rpx;
}
.quick-val { font-size: 28rpx; font-weight: 700; color: #b78300; }
.quick-sub { font-size: 22rpx; color: #8a6b15; margin-top: 4rpx; }
