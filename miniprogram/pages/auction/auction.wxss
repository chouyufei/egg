.tabs {
  display: flex; background: #fff; border-bottom: 1px solid #f0f0f0;
}
.tab {
  flex: 1; text-align: center; padding: 28rpx 0; font-size: 28rpx;
  color: #8a8d93; position: relative;
}
.tab.on { color: #1d1d1f; font-weight: 700; }
.tab.on::after {
  content: ''; position: absolute; bottom: 8rpx; left: 50%;
  transform: translateX(-50%); width: 48rpx; height: 6rpx;
  background: #f6b821; border-radius: 3rpx;
}
.sub-tabs { background: #f5f6f8; }

.search-row { display: flex; gap: 12rpx; align-items: center; margin-bottom: 16rpx; }
.search-input {
  flex: 1; background: #fff; border-radius: 999rpx;
  padding: 14rpx 24rpx; font-size: 26rpx;
}
.filter-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.filter-chip {
  background: #fff; padding: 8rpx 20rpx; border-radius: 999rpx;
  font-size: 24rpx; color: #555;
}

.thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; }
