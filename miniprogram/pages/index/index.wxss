.bell { position: relative; color: #fff; font-size: 40rpx; }
.bell-badge {
  position: absolute; top: -8rpx; right: -16rpx;
  background: #ee0a24; color: #fff;
  padding: 2rpx 10rpx; border-radius: 16rpx; font-size: 20rpx;
}

.hero-tip {
  margin-top: 16rpx; background: rgba(255,255,255,0.18);
  padding: 12rpx 20rpx; border-radius: 12rpx;
  color: #fff; font-size: 24rpx;
}

.search-wrap {
  margin-top: 16rpx; background: rgba(255,255,255,0.85);
  padding: 16rpx 24rpx; border-radius: 999rpx;
  color: #8a8d93; font-size: 26rpx;
}

.guide-card {
  margin: 32rpx 24rpx 0;
  border-left: 8rpx solid #f6b821;
}

.cat-scroll {
  white-space: nowrap;
  padding: 0 24rpx 16rpx;
}
.cat-chip {
  display: inline-block; text-align: center;
  margin-right: 20rpx; padding: 14rpx 8rpx;
  width: 110rpx; background: #fff; border-radius: 16rpx;
  vertical-align: top;
}
.cat-chip.on { background: #fff7e0; border: 2rpx solid #f6b821; }
.cat-icon { font-size: 36rpx; }
.cat-label { font-size: 22rpx; color: #555; margin-top: 4rpx; }

.prov-scroll {
  white-space: nowrap;
  padding: 0 24rpx 16rpx;
}
.prov-chip {
  display: inline-block;
  padding: 10rpx 24rpx; margin-right: 16rpx;
  background: #fff; border-radius: 999rpx;
  font-size: 24rpx; color: #555;
}
.prov-chip.on { background: #f6b821; color: #fff; font-weight: 600; }

.kind-tabs {
  display: flex; background: #fff;
  border-top: 1px solid #f0f0f0;
  border-bottom: 1px solid #f0f0f0;
  align-items: center;
  margin-top: 16rpx;
}
.kind-tab {
  padding: 24rpx 28rpx; font-size: 28rpx; color: #8a8d93;
  position: relative;
}
.kind-tab.on { color: #1d1d1f; font-weight: 700; }
.kind-tab.on::after {
  content: ''; position: absolute; bottom: 6rpx; left: 28rpx; right: 28rpx;
  height: 6rpx; background: #f6b821; border-radius: 3rpx;
}
.kind-tab-pub {
  margin-left: auto; margin-right: 24rpx;
  background: #f6b821; color: #fff;
  padding: 10rpx 24rpx; border-radius: 999rpx;
  font-size: 24rpx; font-weight: 600;
}
