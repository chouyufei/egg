<view class="ec" catchtap="tap">
  <view class="ec-img-wrap">
    <image class="ec-img" mode="aspectFill" src="{{ cover }}" />
    <view class="ec-kind {{ kindCls }}">{{ kindLabel }}</view>
    <view class="ec-status {{ statusCls }}">{{ statusLabel }}</view>
    <view wx:if="{{ r.status === 'auctioning' }}" class="ec-time">
      <text>剩 </text><countdown end-at="{{ r.end_at }}" />
    </view>
  </view>
  <view class="ec-body">
    <view class="ec-title">{{ r.title }}</view>
    <view class="ec-tags">
      <text wx:if="{{ r.egg_color }}" class="ec-tag">{{ r.egg_color }}</text>
      <text wx:if="{{ r.region }}" class="ec-tag ec-tag-g">{{ r.region }}</text>
      <text wx:if="{{ distText }}" class="ec-tag {{ distNear ? 'ec-tag-near' : 'ec-tag-far' }}">📍 {{ distText }}</text>
    </view>
    <view class="ec-foot">
      <view>
        <text class="ec-price">¥{{ r.current_price }}</text>
        <text class="ec-unit">{{ r.unit_label || '元/箱' }}</text>
      </view>
      <view class="ec-meta">{{ r.bid_count || 0 }} 次{{ kindBidLabel }}</view>
    </view>
  </view>
</view>
