<view class="login-page">
  <view class="brand">
    <view class="brand-egg">🥚</view>
    <view class="brand-name">蛋速达</view>
    <view class="brand-slogan">让你的蛋，自己定价</view>
  </view>

  <!-- 选身份阶段：两个大按钮 -->
  <view wx:if="{{ stage === 'pick' }}" class="pick-card">
    <view class="pick-title">您是?</view>
    <view class="pick-btn pick-sell" bindtap="pickRole" data-r="farm">
      <view class="pick-icon">🐔</view>
      <view class="pick-main">我要卖蛋</view>
      <view class="pick-sub">发布货源 / 接采购商订单</view>
    </view>
    <view class="pick-btn pick-buy" bindtap="pickRole" data-r="buyer">
      <view class="pick-icon">🛒</view>
      <view class="pick-main">我要买蛋</view>
      <view class="pick-sub">竞拍货源 / 发布求购需求</view>
    </view>
    <view class="muted text-c mt-16" bindtap="adminLogin">管理员入口 ›</view>
  </view>

  <!-- 输入手机号 + 验证码 -->
  <view wx:else class="login-card">
    <view class="row-between" style="margin-bottom: 24rpx;">
      <view class="bold">{{ roleLabel }} · 登录</view>
      <text class="muted" bindtap="backToPick">‹ 重选</text>
    </view>
    <view class="input-row">
      <view class="label">手机号</view>
      <input model:value="{{ phone }}" type="number" maxlength="11" placeholder="请输入手机号" />
    </view>
    <view class="input-row">
      <view class="label">验证码</view>
      <input model:value="{{ otp }}" type="number" maxlength="6" placeholder="演示请输 123456" />
      <view class="otp-btn" bindtap="sendOtp">{{ cd > 0 ? (cd + 's') : '获取' }}</view>
    </view>

    <button class="btn mt-16" bindtap="login" loading="{{ loading }}">登录 / 注册</button>

    <view class="muted text-c mt-16" style="line-height: 1.8;">
      <view>演示账号（验证码统一 123456）：</view>
      <view wx:if="{{ role === 'farm' }}">养殖场: 13800000001、13800000002（已认证）</view>
      <view wx:if="{{ role === 'buyer' }}">采购商: 13900000001、13900000002</view>
      <view wx:if="{{ role === 'admin' }}">管理员: 13800000000</view>
    </view>
  </view>

  <view class="login-foot">✓ 自主竞拍 · ✓ 双向保证金 · ✓ 7 天自动结算</view>
</view>
