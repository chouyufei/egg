.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #fff; color: #f6b821; display: flex;
  align-items: center; justify-content: center; font-size: 56rpx;
}
.menu-card { padding: 0; overflow: hidden; }
.menu-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 32rpx; border-bottom: 1px solid #f0f0f0;
  font-size: 30rpx;
}
.menu-row:last-child { border-bottom: none; }

/* open-type="contact" button must stay a <button>, but strip its default
   chrome so the row visually aligns with sibling .menu-row views. */
.menu-btn {
  width: 100%;
  margin: 0;
  padding: 28rpx 32rpx;
  line-height: 1.4;
  font-size: 30rpx;
  font-weight: normal;
  text-align: left;
  background: transparent;
  color: inherit;
  border-radius: 0;
}
.menu-btn::after { border: none; }
