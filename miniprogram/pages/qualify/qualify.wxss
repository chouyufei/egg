.qf-page { padding: 24rpx; }

.qf-hero {
  background: linear-gradient(135deg, #d72d2d 0%, #b81d1d 100%);
  color: #fff; border-radius: 16rpx;
  padding: 32rpx 28rpx; margin-bottom: 24rpx;
  position: relative; overflow: hidden;
}
.qf-hero::before {
  content: '🏆🏆🏆'; position: absolute; top: 12rpx; right: 16rpx;
  font-size: 32rpx; opacity: .6;
}
.qf-hero-title { font-size: 38rpx; font-weight: 800; letter-spacing: 2rpx; }
.qf-hero-sub { font-size: 24rpx; opacity: .9; margin-top: 12rpx; line-height: 1.6; }

.qf-intro, .qf-feats { line-height: 1.7; }

.feat-row {
  display: flex; gap: 16rpx;
  padding: 20rpx 0; border-bottom: 1px solid #f0f0f0;
}
.feat-row:last-child { border-bottom: none; }
.feat-icon { font-size: 36rpx; flex-shrink: 0; }

.qf-form-title {
  font-size: 36rpx; font-weight: 800; color: #1d1d1f;
  padding: 16rpx 8rpx; margin-bottom: 12rpx;
}

.picker-val { font-size: 28rpx; color: #1d1d1f; }

.upload-block { padding: 24rpx 0; border-bottom: 1px solid #f0f0f0; }
.upload-block:last-child { border-bottom: none; }
.upload-title { font-size: 26rpx; color: #555; margin-bottom: 16rpx; }
.upload-grid {
  display: flex; flex-wrap: wrap; gap: 16rpx;
}
.upload-thumb, .upload-add {
  width: 160rpx; height: 160rpx; border-radius: 12rpx;
  position: relative;
}
.upload-thumb image { width: 100%; height: 100%; border-radius: 12rpx; }
.upload-del {
  position: absolute; top: -10rpx; right: -10rpx;
  width: 40rpx; height: 40rpx; line-height: 36rpx;
  border-radius: 50%; background: #ee0a24; color: #fff;
  text-align: center; font-size: 28rpx; font-weight: 700;
}
.upload-add {
  background: #f5f6f8; border: 2rpx dashed #d0d0d0;
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; color: #b0b0b0;
}

/* 资质详情 (只读) */
.qf-detail-card { padding: 28rpx 24rpx; }
.qf-section-title {
  font-size: 28rpx; font-weight: 700; color: #1d1d1f;
  padding-bottom: 14rpx; margin-bottom: 8rpx;
  border-bottom: 2rpx solid #f6b821;
  letter-spacing: 1rpx;
}
.qf-kv {
  display: flex; align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1px solid #f5f6f8;
  font-size: 28rpx; line-height: 1.6;
}
.qf-kv:last-child { border-bottom: none; }
.qf-k {
  width: 180rpx; flex-shrink: 0;
  color: #8a8d93; font-size: 26rpx;
}
.qf-v { flex: 1; color: #1d1d1f; word-break: break-all; }
.qf-photos-block { padding: 16rpx 0; }
.qf-photos-title {
  font-size: 24rpx; color: #555;
  margin-bottom: 14rpx;
}
.qf-thumb { background: #f5f6f8; }   /* 图片 src 失败时仍可见占位灰底 */

.addr-map-btn {
  flex-shrink: 0; margin-left: 12rpx;
  font-size: 24rpx; color: #e0a40d;
  padding: 6rpx 18rpx; border: 2rpx solid #f6b821;
  border-radius: 999rpx; background: #fff7e0;
}
.addr-map-btn:active { opacity: 0.6; }
