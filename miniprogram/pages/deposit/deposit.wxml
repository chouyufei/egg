<view class="page-pad">
  <view class="card">
    <view class="bold" style="font-size: 32rpx;">{{ isFarm ? '品质保证金' : '竞拍保证金' }}说明</view>
    <view class="muted mt-8" style="line-height: 1.8;">
      <block wx:if="{{ isFarm }}">
        <view>养殖场需缴纳 <text class="bold">1000 元</text> 品质保证金。</view>
        <view>· 货不对板：扣除 200 元 + 退还差价</view>
        <view>· 长期不发货：扣除 1000 + 200 元 + 退款</view>
        <view>· 严重违规：永久没收，封禁账号</view>
      </block>
      <block wx:else>
        <view>采购商需缴纳 <text class="bold">200 元</text> 竞拍保证金。</view>
        <view>· 每次同时仅冻结一笔</view>
        <view>· 被反超或竞拍结束即自动解冻</view>
        <view>· 中标后 7 天未拉群：扣除全额</view>
      </block>
    </view>
  </view>

  <view class="card">
    <view class="row-between">
      <view>
        <view class="muted">应缴保证金</view>
        <view class="price-l">¥ {{ isFarm ? '1000' : '200' }}</view>
      </view>
      <text class="tag {{ paid ? 'tag-g' : '' }}" style="font-size: 26rpx;">{{ paid ? '已缴纳' : '未缴纳' }}</text>
    </view>
    <button class="btn mt-16" bindtap="pay" disabled="{{ paid || (isFarm && !approved) }}" loading="{{ paying }}">
      {{ paid ? '已缴纳' : (payMode === 'wechat_pay' ? '微信支付 ¥' : '立即缴纳 ¥') + (isFarm ? '1000' : '200') }}
    </button>
    <view wx:if="{{ payMode === 'demo' && !paid }}" class="muted text-c mt-8" style="font-size: 22rpx;">
      ⚠️ 当前为演示模式，未接入真实微信支付
    </view>
    <view wx:if="{{ isFarm && !approved }}" class="muted text-c mt-8">资质审核通过后方可缴纳</view>
  </view>

  <view class="card">
    <view class="section-title" style="margin: 0 0 16rpx;">缴纳记录</view>
    <view wx:for="{{ history }}" wx:key="id" class="row-between" style="padding: 16rpx 0; border-bottom: 1px solid #f0f0f0;">
      <view>
        <view>¥{{ item.amount }}</view>
        <view class="muted" style="font-size: 22rpx;">{{ item.timeText }}</view>
      </view>
      <text class="tag {{ item.statusCls }}">{{ item.statusText }}</text>
    </view>
    <view wx:if="{{ !history.length }}" class="muted text-c" style="padding: 32rpx 0;">暂无记录</view>
  </view>
</view>
