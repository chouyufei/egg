.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #fff; color: #f6b821; display: flex;
  align-items: center; justify-content: center; font-size: 56rpx;
}
.menu-card { padding: 0; overflow: hidden; }
.hero-edit {
  display: inline-block;
  margin-left: 12rpx;
  font-size: 26rpx;
  opacity: .8;
  vertical-align: middle;
}
.menu-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 32rpx; border-bottom: 1px solid #f0f0f0;
  font-size: 30rpx;
}
.menu-row:last-child { border-bottom: none; }

/* "在线客服" 行用普通 view 渲染保证对齐，
   再叠一个隐形 <button open-type="contact"> 接收点击 → 微信原生客服会话 */
.menu-row-rel { position: relative; }
.menu-row-overlay {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  margin: 0; padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
  opacity: 0;
}
.menu-row-overlay::after { border: none; }
