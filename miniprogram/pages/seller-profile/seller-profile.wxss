.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #fff; color: #f6b821; display: flex;
  align-items: center; justify-content: center; font-size: 56rpx;
}

.stats-card {
  display: flex; align-items: stretch;
  padding: 32rpx 16rpx;
}
.stat {
  flex: 1; text-align: center;
}
.stat-num {
  font-size: 40rpx; font-weight: 800; color: #e0a40d;
}
.stat-lbl {
  font-size: 22rpx; color: #8a8d93; margin-top: 6rpx;
}
.stat-sep {
  width: 2rpx; background: #f0f0f0; margin: 8rpx 0;
}

.sub-tabs {
  display: flex; background: #fff;
  border-bottom: 1px solid #f0f0f0;
  margin: 0;
}
.sub-tab {
  flex: 1; text-align: center;
  padding: 24rpx 0; font-size: 28rpx; color: #8a8d93;
  position: relative;
}
.sub-tab.on { color: #1d1d1f; font-weight: 700; }
.sub-tab.on::after {
  content: ''; position: absolute; bottom: 0; left: 30%; right: 30%;
  height: 6rpx; background: #f6b821; border-radius: 3rpx;
}

.kv {
  display: flex; justify-content: space-between;
  padding: 12rpx 0; font-size: 28rpx;
}
